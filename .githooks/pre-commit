#!/usr/bin/env bash
# Hew pre-commit hook.
#
# Enable with:
#   git config core.hooksPath .githooks
#
# Skipped automatically when no Rust files or Cargo manifests are staged
# (e.g. docs-only commits, skill markdown updates).

set -euo pipefail

# ────────────────────────────────────────────────────────────────────────────
# Branch guard — refuse commits on protected branches.
# ────────────────────────────────────────────────────────────────────────────
#
# Workflow is feature-branch → PR → merge. Commits directly on `main`
# break that contract and bypass the GitHub branch protection that
# enforces it server-side.
#
# Emergency override (use sparingly — e.g. for a release-tag commit
# that must land on main directly):
#   HEW_ALLOW_MAIN_COMMIT=1 git commit ...

PROTECTED_BRANCHES="main master"
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

for protected in $PROTECTED_BRANCHES; do
  if [[ "$CURRENT_BRANCH" == "$protected" ]]; then
    if [[ "${HEW_ALLOW_MAIN_COMMIT:-}" == "1" ]]; then
      echo "pre-commit: HEW_ALLOW_MAIN_COMMIT=1 — allowing commit on '$CURRENT_BRANCH'." >&2
      break
    fi
    echo "pre-commit: refusing to commit on protected branch '$CURRENT_BRANCH'." >&2
    echo "pre-commit:   Open a feature branch first:" >&2
    echo "pre-commit:     hew branch new --prefix=<feat|fix|chore|docs> --slug=<text>" >&2
    echo "pre-commit:   Emergency override:" >&2
    echo "pre-commit:     HEW_ALLOW_MAIN_COMMIT=1 git commit ..." >&2
    exit 1
  fi
done

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

if ! printf '%s\n' "$STAGED" | grep -E '(\.rs$|(^|/)Cargo\.toml$)' >/dev/null; then
  exit 0
fi

if ! command -v cargo >/dev/null 2>&1; then
  echo "pre-commit: cargo not on PATH; skipping. Install rust via rustup to enable." >&2
  exit 0
fi

# Emergency bypass — use sparingly. CI re-runs every check.
if [[ "${HEW_SKIP_HOOKS:-}" == "1" ]]; then
  echo "pre-commit: HEW_SKIP_HOOKS=1 set, skipping all checks." >&2
  exit 0
fi

echo "pre-commit: cargo fmt --check"
cargo fmt --all -- --check

echo "pre-commit: cargo clippy --all-targets -- -D warnings"
cargo clippy --all-targets --quiet -- -D warnings

# Tests are gated separately. CI runs them regardless.
#
# Prefer `cargo nextest` when it's on PATH — same coverage, faster wall
# clock (~17s vs ~26s on this workspace, M-series, warm cache). Falls back
# to `cargo test --quiet` so contributors without nextest aren't blocked.
# CONTRIBUTING.md documents how to install it.
if [[ "${HEW_HOOK_NO_TESTS:-}" != "1" ]]; then
  if command -v cargo-nextest >/dev/null 2>&1; then
    echo "pre-commit: cargo nextest run --workspace"
    cargo nextest run --workspace
  else
    echo "pre-commit: cargo test"
    cargo test --quiet
  fi
fi

echo "pre-commit: ok"
